#!/bin/sh
# Regenerates Limine entries on openSUSE Tumbleweed from sdbootutil BLS
# entries (/boot/efi/loader/entries/*.conf).
#
# Layout:
#   //openSUSE Tumbleweed          <- current system (non-snapper BLS entry)
#   //Snapshots/<title>            <- latest $MAX_SNAPSHOT_ENTRIES snapshots
#   //Windows                      <- firmware entry, no disk guessing
#   //Fallback/systemd-boot        <- chainload, safety net
#
# Must run as root (writes $ESP/limine.conf). Test mode:
#   ESP_OVERRIDE=/tmp/fake-esp ./update-limine
# Kernel updates: re-run (or automate via systemd.path, see README below).

ESP="${ESP_OVERRIDE:-/boot/efi}"
CONF="$ESP/limine.conf"
MAX_SNAPSHOT_ENTRIES="${MAX_SNAPSHOT_ENTRIES:-10}"

if [ -z "$ESP_OVERRIDE" ] && [ "$(id -u)" -ne 0 ]; then
    echo "update-limine: must run as root (try: su -c $0)" >&2
    exit 1
fi

ENTRIES="$ESP/loader/entries"
if [ ! -d "$ENTRIES" ]; then
    echo "update-limine: no BLS entries at $ENTRIES" >&2
    exit 1
fi

# Parse one BLS file -> shell vars: bls_title bls_options bls_linux bls_initrd bls_sort
parse_bls() {
    bls_title=""; bls_options=""; bls_linux=""; bls_initrd=""; bls_sort=""
    while IFS= read -r line; do
        case "$line" in
            title\ *|options\ *|linux\ *|initrd\ *|sort-key\ *)
                key="${line%% *}"
                val="${line#* }"
                # trim leading whitespace (BLS aligns values in columns)
                val="${val#"${val%%[![:space:]]*}"}"
                case "$key" in
                    title)    bls_title="$val" ;;
                    options)  bls_options="$val" ;;
                    linux)    bls_linux="$val" ;;
                    initrd)   bls_initrd="$val" ;;
                    sort-key) bls_sort="$val" ;;
                esac
                ;;
        esac
    done < "$1"
}

emit_linux_entry() {
    # $1 = menu path, uses $bls_* vars
    printf '//%s\nprotocol: linux\npath: boot():%s\nmodule_path: boot():%s\ncmdline: %s\n\n' \
        "$1" "$bls_linux" "$bls_initrd" "$bls_options"
}

tmpdir="$(mktemp -d)" || exit 1
trap 'rm -rf "$tmpdir"' EXIT

main_found=0
: > "$tmpdir/snaps.list"
for f in "$ENTRIES"/*.conf; do
    [ -f "$f" ] || continue
    parse_bls "$f"
    [ -n "$bls_linux" ] || continue
    case "$bls_sort" in
        opensuse-tumbleweed)
            printf '%s' "$f" > "$tmpdir/main.file"
            main_found=1
            ;;
        snapper-opensuse-tumbleweed)
            num="${f##*-}"
            num="${num%.conf}"
            printf '%s %s\n' "$num" "$f" >> "$tmpdir/snaps.list"
            ;;
    esac
done

{
echo '# Generated by update-limine - DO NOT EDIT (re-run update-limine)'
echo '# Sources: /boot/efi/loader/entries/*.conf (sdbootutil)'
echo ''
echo 'timeout: 10'
echo 'default_entry: 1'
echo 'remember_last_entry: yes'
echo ''
echo '# Theme: Noctalia dark gray (palette colors)'
echo 'backdrop: 20262C'
echo 'interface_branding: openSUSE'
echo 'interface_branding_color: BBCCE7'
echo 'interface_help_color: 9AA7A1'
echo 'interface_help_color_bright: BBCCE7'
echo 'terminal_foreground: E9EFEB'
echo 'terminal_bright_foreground: F3F7F3'
echo 'terminal_background: E620262C'
echo 'terminal_bright_background: E62A3138'
echo 'terminal_palette: 050B10:857960:82967F:96937B:97A6BB:6C7B91:83A2A3:EFF3EF'
echo 'terminal_bright_palette: 62676C:BFAE87:A4B89B:BBB999:BBCCE7:8E9FBB:A5C9CA:F3F7F3'
echo ''

if [ "$main_found" = "1" ]; then
    parse_bls "$(cat "$tmpdir/main.file")"
    emit_linux_entry "openSUSE Tumbleweed"
else
    echo '# WARNING: no main (non-snapshot) BLS entry found' >&2
fi

sort -k1,1nr "$tmpdir/snaps.list" | head -n "$MAX_SNAPSHOT_ENTRIES" | while read -r num snapfile; do
    [ -n "$snapfile" ] || continue
    parse_bls "$snapfile"
    emit_linux_entry "Snapshots/$bls_title"
done

cat <<'EOF'
//Windows
protocol: efi_boot_entry
entry: Windows Boot Manager

//Fallback/systemd-boot
protocol: efi
path: boot():/EFI/systemd/systemd-bootx64.efi
EOF
} > "$tmpdir/limine.conf.new"

if [ -f "$CONF" ] && cmp -s "$CONF" "$tmpdir/limine.conf.new"; then
    echo "update-limine: $CONF already up to date"
    exit 0
fi
if [ -f "$CONF" ]; then
    cp "$CONF" "$CONF.bak"
    echo "update-limine: backup at $CONF.bak"
fi
cp "$tmpdir/limine.conf.new" "$CONF"
echo "update-limine: wrote $CONF"
